# Google Maps JS API key — powers address autocomplete in the delivery flow.
# Restrict it by HTTP referrer (your domains) in Google Cloud Console and enable
# the "Places API (New)" + "Maps JavaScript API". Exposed to the browser via the
# VITE_ prefix; without it, delivery falls back to geolocation + manual branch pick.
VITE_GOOGLE_MAPS_API_KEY=
